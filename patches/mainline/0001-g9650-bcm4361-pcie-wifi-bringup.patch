 	};
 
+	wlan_en: wlan-en-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-en-regulator";
+
+		gpio = <&tlmm 99 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <70000>;
+
+		pinctrl-0 = <&wlan_en_state>;
+		pinctrl-names = "default";
+	};
+
 	/*
 	 * Apparently RPMh does not provide support for PM8998 S4 because it
 	 * is always-on; model it as a fixed regulator.
@@ -619,6 +631,21 @@ &uart9 {
 	status = "okay";
 };
 
+&pcie0 {
+	status = "okay";
+
+	perst-gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
+	vddpe-3v3-supply = <&wlan_en>;
+
+	pinctrl-0 = <&pcie0_default_state>;
+	pinctrl-names = "default";
+};
+
+&pcie0_phy {
+	status = "okay";
+};
+
 &i2c14 {
 	status = "okay";
 
@@ -1133,6 +1160,37 @@ slpi_ldo_sleep_state: slpi-ldo-sleep-state {
 		output-low;
 	};
 
+	pcie0_default_state: pcie0-default-state {
+		clkreq-pins {
+			pins = "gpio36";
+			function = "pci_e0";
+			bias-pull-up;
+		};
+
+		perst-pins {
+			pins = "gpio35";
+			function = "gpio";
+			drive-strength = <2>;
+			output-low;
+			bias-pull-down;
+		};
+
+		wake-pins {
+			pins = "gpio37";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	wlan_en_state: wlan-en-state {
+		pins = "gpio99";
+		function = "gpio";
+		drive-strength = <2>;
+		output-low;
+		bias-pull-down;
+	};
+
 	i2c18_sda_state: i2c18-sda-state {
 		pins = "gpio62";
 		function = "gpio";
